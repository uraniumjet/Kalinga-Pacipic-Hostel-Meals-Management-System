# Copy to .env and edit. Never commit .env.
# For local development none of these are needed: the defaults work.

# --- Required on a server (DJANGO_DEBUG=0) ---
DJANGO_DEBUG=1
# A long random value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Needed when the site is served over https from another host name, e.g. https://meals.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- https (set when the site is served over https, directly or behind a reverse proxy) ---
DJANGO_HTTPS=0
DJANGO_BEHIND_PROXY=0
DJANGO_HSTS_SECONDS=2592000

# --- Behaviour ---
# Set to 0 to switch off the public "Register your organisation" page
ALLOW_ORG_SIGNUP=1
# Hours before a signed-in user must sign in again
DJANGO_SESSION_HOURS=12
DJANGO_LOG_LEVEL=INFO

# --- Database: leave empty for SQLite, or use PostgreSQL ---
DATABASE_URL=
# Used by docker-compose.yml
POSTGRES_DB=hostel
POSTGRES_USER=hostel
POSTGRES_PASSWORD=
WEB_PORT=8000
